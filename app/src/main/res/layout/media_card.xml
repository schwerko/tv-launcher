<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing": whatever app holds the active media session (Spotify, YouTube, ...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mediaCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/card_bg"
    android:visibility="gone">

    <ImageView
        android:id="@+id/mediaArt"
        android:layout_width="@dimen/media_art_size"
        android:layout_height="@dimen/media_art_size"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:background="@color/tile"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mediaTitle"
            android:nextFocusDown="@+id/mediaPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/media_text_max_width"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/ac_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="@dimen/ac_button_text"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/mediaArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="6dp"
            android:maxWidth="@dimen/media_text_max_width"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/mediaPrev" style="@style/AcButton"
                android:nextFocusUp="@+id/mediaTitle"
                android:src="@drawable/ic_skip_previous" android:contentDescription="@string/media_previous" />
            <ImageView android:id="@+id/mediaPlayPause" style="@style/AcButton"
                android:nextFocusUp="@+id/mediaTitle"
                android:src="@drawable/ic_pause" android:contentDescription="@string/media_play_pause" />
            <ImageView android:id="@+id/mediaNext" style="@style/AcButton"
                android:nextFocusUp="@+id/mediaTitle"
                android:src="@drawable/ic_skip_next" android:contentDescription="@string/media_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
