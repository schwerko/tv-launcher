<?xml version="1.0" encoding="utf-8"?>
<!-- One Home Assistant entity: name over state; pressing toggles / runs it where that applies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:minWidth="@dimen/ha_chip_min_width"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/ac_button"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <TextView
        android:id="@+id/haName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ha_chip_max_width"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/haState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ha_chip_max_width"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="@dimen/ac_button_text"
        android:textColor="@color/text_primary" />
</LinearLayout>
