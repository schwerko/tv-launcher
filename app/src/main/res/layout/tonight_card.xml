<?xml version="1.0" encoding="utf-8"?>
<!-- "What's on tonight": three lines the Ask assistant writes once a day. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tonightCard"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/card_focus"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:visibility="gone">

    <TextView
        android:id="@+id/tonightHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tonight_heading"
        android:textSize="11sp"
        android:textColor="?attr/tlTextSecondary"
        android:textAllCaps="true"
        android:letterSpacing="0.06" />

    <TextView
        android:id="@+id/tonightText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="@dimen/tonight_text"
        android:textColor="?attr/tlTextPrimary"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
