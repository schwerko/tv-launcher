<?xml version="1.0" encoding="utf-8"?>
<!-- One news video: thumbnail, channel and title; pressing opens it in YouTube. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/news_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:foreground="@drawable/tile_focus"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/tlCardGlass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/newsThumb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/news_thumb_height"
            android:scaleType="centerCrop"
            android:background="?attr/tlIconBg"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/newsSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/tlTextSecondary"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/newsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="?attr/tlTextPrimary"
                android:maxLines="2"
                android:minLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/newsAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="?attr/tlAccent"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
