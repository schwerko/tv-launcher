<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingEnd="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="@dimen/clock_text"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="@dimen/date_text"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/weather_temp_text"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/weatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/weather_desc_max_width"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/weather_desc_text"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/askButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/tile_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:text="@string/ask"
            android:textSize="@dimen/header_button_text"
            android:textColor="@color/text_primary"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/tile_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:text="@string/settings"
            android:textSize="@dimen/header_button_text"
            android:textColor="@color/text_primary"
            android:nextFocusDown="@+id/grid" />
    </LinearLayout>

    <!-- Narrow screens (under 480dp wide): the air-conditioner card gets its own row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <include layout="@layout/ac_card" />

        <include layout="@layout/media_card" />
    </LinearLayout>

    <!-- Up to 7 days of calendar events, scrolls sideways; each card is focusable. -->
    <HorizontalScrollView
        android:id="@+id/agendaScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/agendaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/agendaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/all_apps"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/screen_padding_v"
        android:paddingTop="8dp"
        android:nextFocusUp="@id/settingsButton"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>

    <!-- Credit for the current background photo (author, licence, source). -->
    <TextView
        android:id="@+id/wallpaperCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginBottom="6dp"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/caption_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxWidth="600dp"
        android:visibility="gone" />
</FrameLayout>
