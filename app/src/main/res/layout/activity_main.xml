<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- The header (clock, AC, weather, buttons) stays put; everything under it scrolls. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingBottom="0dp">

    <!-- Side padding lives on the header and on the scrolled content (not on this parent), so the
         clipping frame below spans the full width and scaled-up cards at the edges are not cut. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="@dimen/clock_text"
                android:textColor="?attr/tlTextPrimary"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="@dimen/date_text"
                android:textColor="?attr/tlTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/weather_temp_text"
                android:textColor="?attr/tlTextPrimary"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/weatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/weather_desc_max_width"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/weather_desc_text"
                android:textColor="?attr/tlTextSecondary" />

            <TextView
                android:id="@+id/sunTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="@dimen/sun_text"
                android:textColor="?attr/tlTextSecondary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/askButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/tile_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:text="@string/ask"
            android:textSize="@dimen/header_button_text"
            android:textColor="?attr/tlTextPrimary" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/tile_focus"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:text="@string/settings"
            android:textSize="@dimen/header_button_text"
            android:textColor="?attr/tlTextPrimary" />
    </LinearLayout>

    <!-- This frame clips (default) so scrolled rows disappear under the header above. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

    <!-- Narrow screens (under 480dp wide): the air-conditioner card gets its own row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <include layout="@layout/ac_card" />

        <include layout="@layout/media_card" />
    </LinearLayout>

    <include layout="@layout/tonight_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginTop="10dp" />

    <!-- Home Assistant entities chosen in Settings; chips toggle lights, switches, scenes. -->
    <HorizontalScrollView
        android:id="@+id/haScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/haRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Up to 7 days of calendar events, scrolls sideways; each card is focusable. -->
    <HorizontalScrollView
        android:id="@+id/agendaScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/agendaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/agendaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textColor="?attr/tlTextSecondary"
        android:visibility="gone" />

    <!-- Headlines from the RSS feeds chosen in Settings; press a card for the summary. -->
    <HorizontalScrollView
        android:id="@+id/newsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/newsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/all_apps"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:textSize="15sp"
        android:textColor="?attr/tlTextSecondary"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/screen_padding_v"
        android:paddingTop="8dp"
        android:nextFocusUp="@id/settingsButton"
        android:descendantFocusability="afterDescendants" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>

    <!-- Credit for the current background photo (author, licence, source). -->
    <TextView
        android:id="@+id/wallpaperCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:layout_marginBottom="6dp"
        android:textSize="11sp"
        android:textColor="?attr/tlTextSecondary"
        android:background="@drawable/caption_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxWidth="600dp"
        android:visibility="gone" />
</FrameLayout>
