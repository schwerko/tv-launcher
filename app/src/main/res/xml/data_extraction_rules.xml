<?xml version="1.0" encoding="utf-8"?>
<!-- API keys and feed addresses stay on the box: nothing is copied to cloud backups or to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
