<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV only by default: keeps the Play listing off phones and tablets, where a D-pad launcher
         makes no sense. Closed-test builds are made with `-PtvOnly=false` so testers who only
         have a phone can install them (see README "Release build"). -->
    <uses-feature android:name="android.software.leanback" android:required="${leanbackRequired}" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Voice questions need a microphone (the remote's), but typing works without one. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Installed apps are discovered through the <queries> block below (MAIN/LAUNCHER and
         MAIN/LEANBACK_LAUNCHER intents), which is what Play prefers over QUERY_ALL_PACKAGES. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.google.android.youtube.tv" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode">

            <!-- Makes this app selectable as the device HOME screen. -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- So it also shows up in the stock Google TV launcher before you switch. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screensaver (Android "Dream"): nature photos from around the world. -->
        <service
            android:name=".SlideshowDream"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
